pipeline {
    agent any
    parameters{
        string(name: 'FRONTEND_DOCKER_TAG', defaultValue: '', description: 'tag of frontend image')
        string(name: 'BACKEND_DOCKER_TAG', defaultValue: '', description: 'tag of endend image')
    }
    stages {
        stage('Cleaning Workspace') {
            steps {
                script {
                    cleanWs()
                }
            }
        }
        
        stage('Git Checkout') {
            steps {
                script {
                    git branch: 'main', url: 'https://github.com/Arvind-26/MERN-app-deployment-DevSecOps'
                }
            }
        }
        
        stage('Verify tag') {
            steps {
                script {
                    echo 'FRONTEND_DOCKER_TAG: ${parama.FRONTEND_DOCKER_TAG}'
                    echo 'BACKEND_DOCKER_TAG: ${parama.BACKEND_DOCKER_TAG}'
                }
            }
        }
        
        stage('update kubernetes menifest') {
            steps {
                script {
                    dir('kubernetes'){
                        sh """
                            sed -i "s|arvind2611/mern-e-commerce-store_frontend:[^ ]*|arvind2611/mern-e-commerce-store_frontend:${params.FRONTEND_DOCKER_TAG}|g" frontend.yml
                        """
                    }
                    dir('kubernetes'){
                        sh """
                            sed -i "s|arvind2611/mern-e-commerce-store_backend:[^ ]*|arvind2611/mern-e-commerce-store_backend:${params.BACKEND_DOCKER_TAG}|g" backend.yml
                        """
                    }
                }
            }
        }
        
        stage('git code upadte and push to github'){
            steps{
                script{
                    withCredentials([gitUsernamePassword(credentialsId: 'github-login', gitToolName: 'Default')]) {
                        sh """
                            echo "checking repo status"
                            git status
                            
                            echo setting git config
                            git config --global user.email "jenkins@arvind.com"
                            git config --global user.name "Arvind"
                            
                            echo "add all changes"
                            git add .
                            
                            echo "commit changes"
                            git commit -m "new tags"
                            
                            echo "pushing to repo"
                            git push https://github.com/Arvind-26/MERN-app-deployment-DevSecOps.git main
                        """
                    }
                }
            }
        }
    }
    post {
        success {
            script {
                emailext attachLog: true,
                from: 'arvind1.test@gmail.com',
                subject: "E-commerce Application has been updated and deployed - '${currentBuild.result}'",
                body: """
                    <html>
                    <body>
                        <div style="background-color: #FFA07A; padding: 10px; margin-bottom: 10px;">
                            <p style="color: black; font-weight: bold;">Project: ${env.JOB_NAME}</p>
                        </div>
                        <div style="background-color: #90EE90; padding: 10px; margin-bottom: 10px;">
                            <p style="color: black; font-weight: bold;">Build Number: ${env.BUILD_NUMBER}</p>
                        </div>
                        <div style="background-color: #87CEEB; padding: 10px; margin-bottom: 10px;">
                            <p style="color: black; font-weight: bold;">URL: ${env.BUILD_URL}</p>
                        </div>
                    </body>
                    </html>
            """,
            to: 'arvind1.test@gmail.com',
            mimeType: 'text/html'
            }
        }
      failure {
            script {
                emailext attachLog: true,
                from: 'arvind1.test@gmail.com',
                subject: "E-commerce Application build failed - '${currentBuild.result}'",
                body: """
                    <html>
                    <body>
                        <div style="background-color: #FFA07A; padding: 10px; margin-bottom: 10px;">
                            <p style="color: black; font-weight: bold;">Project: ${env.JOB_NAME}</p>
                        </div>
                        <div style="background-color: #90EE90; padding: 10px; margin-bottom: 10px;">
                            <p style="color: black; font-weight: bold;">Build Number: ${env.BUILD_NUMBER}</p>
                        </div>
                    </body>
                    </html>
            """,
            to: 'arvind1.test@gmail.com',
            mimeType: 'text/html'
            }
        }
    }
}
